# .env.cloud-run.<staging|prod>
# Copy this file and populate with real values:
#   cp .env.cloud-run.example .env.cloud-run.staging
#   cp .env.cloud-run.example .env.cloud-run.prod

# ── Secrets (pushed to GCP Secret Manager) ──
F3_GOOGLE_API_KEY=AIzaSy...
OAUTH_CLIENT_SECRET=...
GCS_CREDENTIALS=...
# @acme/api now runs in-process here (~/orpc/client.server.ts, #654), so this
# service needs the same DB/mail/API-key secrets apps/api's own Cloud Run
# service has — including direct Cloud SQL access (Cloud SQL Client IAM role
# + VPC connector), which admin never required before this change.
API_KEY=<your-admin-api-key>
AUTH_SECRET=<your-admin-auth-secret>
DATABASE_URL=postgresql://user:pass@prod.db.f3nation.com:5432/f3nation
EMAIL_SERVER=smtp://apikey:SG.xxxx@smtp.sendgrid.net:587

# ── Per-environment plain env vars ──
AUTH_PROVIDER_URL=https://auth2.f3nation.com
EMAIL_ADMIN_DESTINATIONS=admin@f3nation.com
EMAIL_FROM="F3 Support <support@f3nation.com>"
F3_API_BASE_URL=https://api.f3nation.com/v1
F3_ADMIN_BASE_URL=https://admin.f3nation.com
F3_MAP_BASE_URL=https://map.f3nation.com
F3_CHANNEL=prod
# @acme/api verifies bearer JWTs against this issuer's JWKS endpoint —
# same value as AUTH_PROVIDER_URL above, but read via a separate var name.
NEXT_PUBLIC_AUTH_URL=https://auth2.f3nation.com
OAUTH_CLIENT_ID=f3-admin-prod
OAUTH_REDIRECT_URI=https://admin.f3nation.com/api/auth/callback
GCS_EMULATOR_HOST=

# Pino log level: trace | debug | info | warn | error | fatal (default: info).
LOG_LEVEL=info